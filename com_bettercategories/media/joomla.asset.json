{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "com_bettercategories",
  "version": "1.8.1",
  "description": "Better Categories for Gridbox: the control panel, the pages of settings and the quick setup",
  "license": "GPL-3.0-or-later",
  "assets": [
    {
      "name": "com_bettercategories.admin",
      "type": "style",
      "uri": "com_bettercategories/bettercategories-admin.css"
    },
    {
      "name": "com_bettercategories.setup",
      "type": "script",
      "uri": "com_bettercategories/bettercategories-setup.js",
      "dependencies": [
        "core"
      ],
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "com_bettercategories.cpanel",
      "type": "script",
      "uri": "com_bettercategories/bettercategories-cpanel.js",
      "dependencies": [
        "core"
      ],
      "attributes": {
        "defer": true
      }
    }
  ]
}

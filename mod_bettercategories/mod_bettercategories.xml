<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>mod_bettercategories</name>
    <author>Merserwis</author>
    <authorUrl>https://github.com/merserwis/</authorUrl>
    <creationDate>2026-11-23</creationDate>
    <copyright>Copyright (C) 2026 Merserwis. All rights reserved.</copyright>
    <license>GNU General Public License version 3</license>
    <version>1.11.0</version>
    <description>MOD_BETTERCATEGORIES_XML_DESCRIPTION</description>
    <namespace path="src">Merserwis\Module\BetterCategories</namespace>
    <files>
        <folder module="mod_bettercategories">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>
    <languages folder="language">
        <language tag="en-GB">en-GB/mod_bettercategories.ini</language>
        <language tag="en-GB">en-GB/mod_bettercategories.sys.ini</language>
        <language tag="de-DE">de-DE/mod_bettercategories.ini</language>
        <language tag="de-DE">de-DE/mod_bettercategories.sys.ini</language>
        <language tag="pl-PL">pl-PL/mod_bettercategories.ini</language>
        <language tag="pl-PL">pl-PL/mod_bettercategories.sys.ini</language>
        <language tag="fr-FR">fr-FR/mod_bettercategories.ini</language>
        <language tag="fr-FR">fr-FR/mod_bettercategories.sys.ini</language>
        <language tag="cs-CZ">cs-CZ/mod_bettercategories.ini</language>
        <language tag="cs-CZ">cs-CZ/mod_bettercategories.sys.ini</language>
        <language tag="nl-NL">nl-NL/mod_bettercategories.ini</language>
        <language tag="nl-NL">nl-NL/mod_bettercategories.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic" addfieldprefix="Merserwis\Plugin\System\BetterCategories\Field">
                <field name="module_info" type="note" class="alert alert-info" description="MOD_BETTERCATEGORIES_INFO" />
                <field name="kind" type="list" default="list" label="MOD_BETTERCATEGORIES_KIND_LABEL" description="MOD_BETTERCATEGORIES_KIND_DESC">
                    <option value="list">MOD_BETTERCATEGORIES_KIND_LIST</option>
                    <option value="menu">MOD_BETTERCATEGORIES_KIND_MENU</option>
                </field>
                <field name="category" type="gbcategories" default="0" label="MOD_BETTERCATEGORIES_CATEGORY_LABEL" description="MOD_BETTERCATEGORIES_CATEGORY_DESC">
                    <option value="0">MOD_BETTERCATEGORIES_CATEGORY_HOME</option>
                </field>
                <field name="app_id" type="number" default="0" min="0" label="MOD_BETTERCATEGORIES_APP_LABEL" description="MOD_BETTERCATEGORIES_APP_DESC" showon="category:0" />
                <field name="heading" type="text" default="" label="MOD_BETTERCATEGORIES_HEADING_LABEL" description="MOD_BETTERCATEGORIES_INHERIT_DESC" showon="kind:list" />
                <field name="display" type="list" default="" label="MOD_BETTERCATEGORIES_DISPLAY_LABEL" showon="kind:list">
                    <option value="">MOD_BETTERCATEGORIES_INHERIT</option>
                    <option value="text">MOD_BETTERCATEGORIES_DISPLAY_TEXT</option>
                    <option value="tiles">MOD_BETTERCATEGORIES_DISPLAY_TILES</option>
                </field>
                <field name="tile_style" type="list" default="" label="MOD_BETTERCATEGORIES_TILE_STYLE_LABEL" showon="kind:list">
                    <option value="">MOD_BETTERCATEGORIES_INHERIT</option>
                    <option value="below">MOD_BETTERCATEGORIES_TILE_STYLE_BELOW</option>
                    <option value="card">MOD_BETTERCATEGORIES_TILE_STYLE_CARD</option>
                    <option value="overlay">MOD_BETTERCATEGORIES_TILE_STYLE_OVERLAY</option>
                    <option value="cover">MOD_BETTERCATEGORIES_TILE_STYLE_COVER</option>
                </field>
                <field name="orientation" type="list" default="" label="MOD_BETTERCATEGORIES_ORIENTATION_LABEL" showon="kind:list">
                    <option value="">MOD_BETTERCATEGORIES_INHERIT</option>
                    <option value="rows">MOD_BETTERCATEGORIES_ORIENTATION_ROWS</option>
                    <option value="columns">MOD_BETTERCATEGORIES_ORIENTATION_COLUMNS</option>
                    <option value="scroll">MOD_BETTERCATEGORIES_ORIENTATION_SCROLL</option>
                    <option value="inline">MOD_BETTERCATEGORIES_ORIENTATION_INLINE</option>
                </field>
                <field name="columns" type="list" default="" label="MOD_BETTERCATEGORIES_COLUMNS_LABEL" showon="kind:list">
                    <option value="">MOD_BETTERCATEGORIES_INHERIT</option>
                    <option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option>
                    <option value="5">5</option><option value="6">6</option><option value="7">7</option><option value="8">8</option>
                </field>
                <field name="columns_tablet" type="list" default="" label="MOD_BETTERCATEGORIES_COLUMNS_TABLET_LABEL" showon="kind:list">
                    <option value="">MOD_BETTERCATEGORIES_INHERIT</option>
                    <option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option>
                    <option value="5">5</option><option value="6">6</option><option value="7">7</option><option value="8">8</option>
                </field>
                <field name="columns_mobile" type="list" default="" label="MOD_BETTERCATEGORIES_COLUMNS_MOBILE_LABEL" showon="kind:list">
                    <option value="">MOD_BETTERCATEGORIES_INHERIT</option>
                    <option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option>
                    <option value="5">5</option><option value="6">6</option><option value="7">7</option><option value="8">8</option>
                </field>
                <field name="sub_mode" type="list" default="" label="MOD_BETTERCATEGORIES_SUB_MODE_LABEL" showon="kind:list">
                    <option value="">MOD_BETTERCATEGORIES_INHERIT</option>
                    <option value="none">MOD_BETTERCATEGORIES_SUB_MODE_NONE</option>
                    <option value="below">MOD_BETTERCATEGORIES_SUB_MODE_BELOW</option>
                    <option value="drawer">MOD_BETTERCATEGORIES_SUB_MODE_DRAWER</option>
                    <option value="side">MOD_BETTERCATEGORIES_SUB_MODE_SIDE</option>
                    <option value="flip">MOD_BETTERCATEGORIES_SUB_MODE_FLIP</option>
                    <option value="tooltip">MOD_BETTERCATEGORIES_SUB_MODE_TOOLTIP</option>
                </field>
                <field name="price_from" type="list" default="" label="MOD_BETTERCATEGORIES_PRICE_LABEL" showon="kind:list">
                    <option value="">MOD_BETTERCATEGORIES_INHERIT</option>
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="menu_note" type="note" class="alert alert-light" description="MOD_BETTERCATEGORIES_MENU_NOTE" showon="kind:menu" />
                <field name="menu_style" type="list" default="button" label="MOD_BETTERCATEGORIES_MENU_STYLE_LABEL" description="MOD_BETTERCATEGORIES_MENU_STYLE_DESC" showon="kind:menu">
                    <option value="button">MOD_BETTERCATEGORIES_MENU_STYLE_BUTTON</option>
                    <option value="bar">MOD_BETTERCATEGORIES_MENU_STYLE_BAR</option>
                    <option value="panel">MOD_BETTERCATEGORIES_MENU_STYLE_PANEL</option>
                </field>
                <field name="menu_label" type="text" default="" label="MOD_BETTERCATEGORIES_MENU_LABEL_LABEL" hint="MOD_BETTERCATEGORIES_MENU_LABEL_HINT" showon="kind:menu" />
                <field name="menu_trigger" type="list" default="hover" label="MOD_BETTERCATEGORIES_MENU_TRIGGER_LABEL" description="MOD_BETTERCATEGORIES_MENU_TRIGGER_DESC" showon="kind:menu[AND]menu_style!:panel">
                    <option value="hover">MOD_BETTERCATEGORIES_MENU_TRIGGER_HOVER</option>
                    <option value="click">MOD_BETTERCATEGORIES_MENU_TRIGGER_CLICK</option>
                </field>
                <field name="menu_depth" type="list" default="3" label="MOD_BETTERCATEGORIES_MENU_DEPTH_LABEL" description="MOD_BETTERCATEGORIES_MENU_DEPTH_DESC" showon="kind:menu">
                    <option value="2">2</option>
                    <option value="3">3</option>
                </field>
                <field name="menu_leaves" type="number" default="6" min="0" max="50" label="MOD_BETTERCATEGORIES_MENU_LEAVES_LABEL" description="MOD_BETTERCATEGORIES_MENU_LEAVES_DESC" showon="kind:menu[AND]menu_depth:3" />
                <field name="menu_columns" type="list" default="4" label="MOD_BETTERCATEGORIES_MENU_COLUMNS_LABEL" showon="kind:menu">
                    <option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option>
                </field>
                <field name="menu_images" type="list" default="groups" label="MOD_BETTERCATEGORIES_MENU_IMAGES_LABEL" description="MOD_BETTERCATEGORIES_MENU_IMAGES_DESC" showon="kind:menu">
                    <option value="none">MOD_BETTERCATEGORIES_MENU_IMAGES_NONE</option>
                    <option value="groups">MOD_BETTERCATEGORIES_MENU_IMAGES_GROUPS</option>
                    <option value="all">MOD_BETTERCATEGORIES_MENU_IMAGES_ALL</option>
                </field>
                <field name="menu_counts" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="MOD_BETTERCATEGORIES_MENU_COUNTS_LABEL" showon="kind:menu">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="menu_price" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="MOD_BETTERCATEGORIES_MENU_PRICE_LABEL" description="MOD_BETTERCATEGORIES_MENU_PRICE_DESC" showon="kind:menu">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="menu_accent" type="color" default="" label="MOD_BETTERCATEGORIES_MENU_ACCENT_LABEL" showon="kind:menu" />
            </fieldset>
            <fieldset name="advanced">
                <field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout" />
                <field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier" />
            </fieldset>
        </fields>
    </config>
</extension>

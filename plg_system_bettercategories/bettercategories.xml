                    <option value="list">PLG_SYSTEM_BETTERCATEGORIES_SUB_STYLE_LIST</option>
                    <option value="inline">PLG_SYSTEM_BETTERCATEGORIES_SUB_STYLE_INLINE</option>
                    <option value="chips">PLG_SYSTEM_BETTERCATEGORIES_SUB_STYLE_CHIPS</option>
                </field>
                <field name="sub_max" type="number" default="6" min="0" max="50" label="PLG_SYSTEM_BETTERCATEGORIES_SUB_MAX_LABEL" description="PLG_SYSTEM_BETTERCATEGORIES_SUB_MAX_DESC" showon="sub_mode!:none" />
                <field name="sub_counts" type="radio" layout="joomla.form.field.radio.switcher" default="0" label="PLG_SYSTEM_BETTERCATEGORIES_SUB_COUNTS_LABEL" showon="sub_mode!:none">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
